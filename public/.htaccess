<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não reescreve arquivos ou pastas que existem de verdade
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Qualquer outra rota cai no index.html (React Router assume daqui)
  RewriteRule . /index.html [L]
</IfModule>
